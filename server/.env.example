# ============================================
# Ramji Bakery — Backend Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# On Render: add these same keys in Dashboard → Environment.

# --- Server ---
PORT=10000
NODE_ENV=production

# --- MongoDB ---
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ramjibakery?retryWrites=true&w=majority
# Optional fallback if SRV DNS fails on some hosts
MONGODB_URI_FALLBACK=

# --- Authentication ---
JWT_SECRET=replace-with-a-long-secure-random-string
SESSION_SECRET=replace-with-another-secure-random-string

# --- Admin Seed ---
ADMIN_EMAIL=admin@ramjibakery.in
ADMIN_PASSWORD=change-this-password
ADMIN_ROLE=superadmin

# --- Cloudinary (Image Uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (Nodemailer / Gmail SMTP) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
ENABLE_ORDER_EMAIL=false
ENABLE_ACCOUNT_EMAIL=false

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://ram-ji-bakery23.onrender.com/api/auth/google/callback

# --- Owner Contact ---
OWNER_PHONE=0000000000
OWNER_EMAIL=your-email@example.com
ORDER_NOTIFICATION_WHATSAPP=910000000000

# --- Frontend URLs ---
FRONTEND_URL=https://ram-ji-bakery23.vercel.app
PUBLIC_STORE_URL=https://ram-ji-bakery23.vercel.app
PUBLIC_API_URL=https://ram-ji-bakery23.onrender.com/api
BACKEND_URL=https://ram-ji-bakery23.onrender.com

# --- DEPLOYMENT GUIDE ---
# LOCAL: Use these values in your local .env file.
# RENDER: Add the SAME keys in Dashboard → Environment tab.
# VERCEL: Add NEXT_PUBLIC_API_URL in Vercel → Settings → Environment Variables.
# IMPORTANT: Never use "localhost" in production variables.
