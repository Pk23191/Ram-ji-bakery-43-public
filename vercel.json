{
  "version": 2,
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ram-ji-bakery23.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://ram-ji-bakery23.onrender.com/uploads/:path*"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "@next_public_api_url"
  }
}
